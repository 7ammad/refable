@@ -0,0 +1,17 @@
+const { test } = require("node:test");
+const assert = require("node:assert");
+const { isSessionValid, SESSION_TTL_MS } = require("./server");
+
+const NOW = 1_000_000_000_000;
+
+test("fresh session is valid", () => {
+  assert.equal(isSessionValid({ username: "demo", createdAt: NOW - 1000 }, NOW), true);
+});
+
+test("session just under TTL is valid", () => {
+  assert.equal(isSessionValid({ username: "demo", createdAt: NOW - SESSION_TTL_MS + 1 }, NOW), true);
+});
+
+test("session past TTL is expired", () => {
+  assert.equal(isSessionValid({ username: "demo", createdAt: NOW - SESSION_TTL_MS - 1 }, NOW), false);
+});
